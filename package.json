{
  "name": "research-writer-agents",
  "version": "0.1.0",
  "description": "TypeScript CLI for a deterministic, multi-agent research writer pipeline with optional OpenAI Responses API support.",
  "type": "module",
  "private": true,
  "bin": {
    "research-writer-agents": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "openai": "^6.39.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
