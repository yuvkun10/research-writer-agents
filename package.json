{
  "name": "research-writer-agents",
  "version": "0.1.0",
  "description": "TypeScript CLI for a deterministic, multi-agent research writer pipeline with optional OpenAI Responses API support.",
  "type": "module",
  "private": true,
  "bin": {
    "research-writer-agents": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "openai": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
